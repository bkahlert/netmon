#!/usr/bin/env bash
# Purpose: Samples the kiosk's CPU and memory for the panel's status bar and writes them as JSON.
# Usage:   netmon-display-stats [--out <file>] [--interval <seconds>] [--root <dir>] [--once]
#
# Options:
#   --out <file>          The JSON file to write (default: /run/netmon-display/stats.json).
#   --interval <seconds>  Seconds between two samples (default: 5).
#   --root <dir>          Directory holding sys/ and proc/, for a fixture (default: /).
#   --once                Write one sample and exit.
#   -h, --help            Show this help.
#
# Examples:
#   netmon-display-stats --once --interval 1 --out /tmp/stats.json && cat /tmp/stats.json
#   {"at":1759450000,"interval":1,"kioskCpu":118,"webCpu":114,"kioskMemory":168820736}

set -euo pipefail

usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "${BASH_SOURCE[0]}"; }
die()   { printf '%s: %s\nSee '\''%s --help'\''\n' "${0##*/}" "$1" "${0##*/}" >&2; exit 2; }

out=/run/netmon-display/stats.json; interval=5; root=/; once=false
while (( $# )); do
  case $1 in
    -h|--help)    usage; exit 0 ;;
    --out)        out=${2?--out: missing value}; shift 2 ;;
    --out=*)      out=${1#*=}; shift ;;
    --interval)   interval=${2?--interval: missing value}; shift 2 ;;
    --interval=*) interval=${1#*=}; shift ;;
    --root)       root=${2?--root: missing value}; shift 2 ;;
    --root=*)     root=${1#*=}; shift ;;
    --once)       once=true; shift ;;
    -?*)          die "unknown option: $1" ;;
    *)            die "unexpected argument: $1" ;;
  esac
done

cgroup="${root%/}/sys/fs/cgroup/system.slice/pihero-kiosk.service"
proc="${root%/}/proc"
tick=$(getconf CLK_TCK)

# The readers set their variable from a kiosk file, empty when the file does not open or lacks the figure: the kiosk
# comes and goes, and bash reads by itself because the forks of cat and awk would show up in the figures.

# Uptime in centiseconds: a monotonic clock that no time sync steps and no locale formats.
read_uptime() {
  local rest
  up=""
  { read -r up rest || true; } 2>/dev/null < "$proc/uptime" || true
  up=${up/./}
}

# The kiosk cgroup's CPU time in microseconds.
read_kiosk_usec() {
  local key value
  usec=""
  { while read -r key value; do if [[ $key == usage_usec ]]; then usec=$value; break; fi; done; } 2>/dev/null < "$cgroup/cpu.stat" || true
}

# The kiosk cgroup's RAM plus zram in bytes.
read_kiosk_memory() {
  local ram="" swap=""
  memory=""
  { read -r ram || true; } 2>/dev/null < "$cgroup/memory.current" || return 0
  { read -r swap || true; } 2>/dev/null < "$cgroup/memory.swap.current" || true
  [[ -n $ram ]] && memory=$(( ram + ${swap:-0} ))
}

# The PID of the kiosk's web process.
read_web_pid() {
  local p comm
  pid=""
  {
    while read -r p; do
      comm=""
      { read -r comm || true; } 2>/dev/null < "$proc/$p/comm" || true
      if [[ $comm == WPEWebProcess ]]; then pid=$p; break; fi
    done
  } 2>/dev/null < "$cgroup/cgroup.procs" || true
}

# The CPU ticks of the web process in user and kernel mode.
read_web_ticks() {
  local stat=""
  ticks=""
  [[ -n $pid ]] || return 0
  { read -r stat || true; } 2>/dev/null < "$proc/$pid/stat" || return 0
  # shellcheck disable=SC2086  # the words after the parenthesised command name are meant to split
  set -- ${stat##*) }
  (( $# >= 13 )) || return 0
  ticks=$(( ${12} + ${13} ))
}

read_kiosk() { read_uptime; read_kiosk_usec; read_web_pid; read_web_ticks; }

json() { printf '{"at":%s,"interval":%s,"kioskCpu":%s,"webCpu":%s,"kioskMemory":%s}\n' "$1" "$interval" "${2:-null}" "${3:-null}" "${4:-null}"; }

read_kiosk
prev_up=$up; prev_usec=$usec; prev_pid=$pid; prev_ticks=$ticks
while :; do
  sleep "$interval"
  read_kiosk; read_kiosk_memory
  elapsed=$(( (up - prev_up) * 10000 ))
  kiosk_cpu=""; web_cpu=""
  # A counter below its last value belongs to a new cgroup or process, so that sample has no figure.
  if (( elapsed > 0 )); then
    if [[ -n $usec && -n $prev_usec ]] && (( usec >= prev_usec )); then kiosk_cpu=$(( (usec - prev_usec) * 100 / elapsed )); fi
    if [[ -n $pid && $pid == "$prev_pid" && -n $ticks && -n $prev_ticks ]] && (( ticks >= prev_ticks )); then
      web_cpu=$(( (ticks - prev_ticks) * 100 * 1000000 / (tick * elapsed) ))
    fi
  fi
  printf -v at '%(%s)T' -1
  json "$at" "$kiosk_cpu" "$web_cpu" "$memory" > "$out.tmp" && mv -f "$out.tmp" "$out"
  prev_up=$up; prev_usec=$usec; prev_pid=$pid; prev_ticks=$ticks
  if $once; then exit 0; fi
done
