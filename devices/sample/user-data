  # MODEL selects the icon Finder shows; the choices are pictured in pihero's devices/README.md.
  - path: /etc/pihero/device-info.conf
    content: MODEL=AirPort4
  # PRODUCT names the gadget on the USB host (the board model if unset); CIDR is the subnet the Pi serves to it.
  - path: /etc/pihero/usb-gadget.conf
    content: |
      PRODUCT="Network Monitor"
      CIDR=10.10.10.10/29
  # The kiosk shows the web display; the page takes the broker from the URL. The mode hint is for a panel without EDID.
  # COG_ARGS: the document-viewer cache model; WebKit's own memory limit for the web process, checked every ten seconds,
  # so it frees caches before the kernel swaps it; a web process restart at the kill threshold as the leak guard.
  # JSC_ and WEBKIT_ reach the web process through its environment: the upper JIT tiers off, one Skia painting thread.
  - path: /etc/pihero/kiosk.conf
    content: |
      URL=http://localhost/?broker.host=localhost&broker.port=8080
      COG_PLATFORM_DRM_VIDEO_MODE=800x480
      COG_ARGS="--doc-viewer --web-mem-limit=200 --web-check-interval=10 --web-kill-threshold=0.95 --webprocess-failure=restart"
      JSC_useDFGJIT=false
      JSC_useFTLJIT=false
      WEBKIT_SKIA_CPU_PAINTING_THREADS=1
runcmd:
  - hostnamectl set-hostname --pretty "Network Monitor"
  - systemctl restart pihero-avahi-render.service
  # A panel without EDID (the HAMTYSAN 7-inch) needs its mode forced on; MemoryMax= binds only with the memory controller on.
  - /usr/lib/pihero/bootconfig add cmdline video=HDMI-A-1:800x480M@60e --package netmon-display
  - /usr/lib/pihero/bootconfig add cmdline cgroup_enable=memory --package netmon-scanner
  # Tailscale: uncomment to join a tailnet on first boot with a single-use, expiring auth key (tailscale.com/kb/1085). For an
  # exit node keep the forwarding line and the flag, then approve the node under Machines in the admin console (kb/1103).
  # - curl -fsSL https://tailscale.com/install.sh | sh
